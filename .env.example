# Copy to .env (local) and set the same values as Supabase secrets in production.
# NEVER commit real values.

# Supabase (public values are used by the PWA, the service role key only by server-side jobs)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ODPT access token (https://developer.odpt.org). Needed only for feeds on api.odpt.org
# (Yokohama Municipal Bus; same name as the Supabase secret). Toei and Keisei work without it via api-public.odpt.org.
ODPT_KEY=

# TomTom (Traffic category, disabled until enabled in the city config)
TOMTOM_API_KEY=

# Web push through OneSignal. The app id is public (also set VITE_ONESIGNAL_APP_ID for the web build);
# the REST API key is a secret: set it ONLY as a Supabase Edge Function secret, never in the web build.
VITE_ONESIGNAL_APP_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Shared secret that protects the cron-triggered functions
CRON_SECRET=
