# Copy to .env (local) and set the same values as Supabase secrets in production.
# NEVER commit real values.

# Supabase (public values are used by the PWA, the service role key only by server-side jobs)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ODPT access token (https://developer.odpt.org). Needed only for feeds on api.odpt.org
# (e.g. Yokohama Municipal Bus). Toei and Keisei work without it via api-public.odpt.org.
ODPT_TOKEN=

# TomTom (Traffic category, disabled until enabled in the city config)
TOMTOM_API_KEY=

# Web push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret that protects the cron-triggered functions
CRON_SECRET=
