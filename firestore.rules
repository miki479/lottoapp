rules_version = '2';
// Everything the player cannot be trusted with (credits, bets, settlement) is written only by
// Cloud Functions (Admin SDK bypasses these rules). Clients can only read.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /markets/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /bets/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /feedHealth/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
