{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "lib", "rootDir": "src", "strict": true, "noUncheckedIndexedAccess": true,
    "rewriteRelativeImportExtensions": true, "resolveJsonModule": true, "skipLibCheck": true, "esModuleInterop": true
  },
  "include": ["src"]
}
